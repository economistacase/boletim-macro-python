{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(quarto:*)",
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "WebFetch",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(test:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(grep:*)"
    ],
    "ask": [
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python python/hook_log.py"
          }
        ]
      }
    ]
  }
}
